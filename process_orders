import argparse
import json
from collections import defaultdict

def read_json_file(file_name):
    with open(file_name, 'r') as file:
        return json.load(file)

def write_json_file(file_name, data):
    with open(file_name, 'w') as file:
        json.dump(data, file, indent=4)

def process_orders(file_name):
    orders = read_json_file(file_name)
    
    customers = {}
    items = defaultdict(lambda: {'price': 0, 'orders': 0})
    
    for order in orders:
        phone = order['phone']
        name = order['name']
        customers[phone] = name
        
        for item in order['items']:
            item_name = item['name']
            item_price = item['price']
            items[item_name]['price'] = item_price
            items[item_name]['orders'] += 1
    
    write_json_file('customers.json', customers)
    write_json_file('items.json', items)

if __name__ == '__main__':
    parser = argparse.ArgumentParser(description="Process JSON orders")
    parser.add_argument('file_name', type=str, help="Name of the JSON file containing orders")
    args = parser.parse_args()
    
    process_orders(args.file_name)
